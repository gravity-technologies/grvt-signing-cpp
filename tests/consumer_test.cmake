# Verify a separate consumer using only the installed package.
file(REMOVE_RECURSE ${WORK_DIR})
set(prefix ${WORK_DIR}/prefix)
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "failed (${rc}): ${ARGN}")
  endif()
endfunction()
run(${CMAKE_COMMAND} --install ${BUILD_DIR} --prefix ${prefix})
if(NOT EXISTS "${prefix}/share/grvt_signing/signing.json")
  message(FATAL_ERROR "shared signing test cases (signing.json) were not installed")
endif()
if(NOT WITH_SIGNER)
  set(no_secp -DCMAKE_DISABLE_FIND_PACKAGE_Secp256k1=TRUE)
endif()
run(${CMAKE_COMMAND} -S ${CONSUMER_DIR} -B ${WORK_DIR}/build -DCMAKE_PREFIX_PATH=${prefix} -DCMAKE_CXX_COMPILER=${CXX} -DWITH_SIGNER=${WITH_SIGNER} ${no_secp})
run(${CMAKE_COMMAND} --build ${WORK_DIR}/build)
run(${WORK_DIR}/build/consumer)
