@PACKAGE_INIT@

# The static library links libsecp256k1 privately; consumers still need it at link time.
include(CMakeFindDependencyMacro)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
if(@GRVT_SIGNING_WITH_SECP256K1@)
  find_dependency(Secp256k1)
endif()
list(POP_FRONT CMAKE_MODULE_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/grvt_signingTargets.cmake")
check_required_components(grvt_signing)
